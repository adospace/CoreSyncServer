@using ApexCharts

@* Stacked bar chart showing sync session activity over time, powered by ApexCharts *@

<div class="activity-chart">
    @if (DataPoints is null || DataPoints.Count == 0)
    {
        <div class="h-64 flex items-center justify-center text-gray-400">
            <p>No activity data available.</p>
        </div>
    }
    else
    {
        <ApexChart TItem="DataPoint" Options="_options" Height="256">
            <ApexPointSeries TItem="DataPoint"
                             Items="DataPoints"
                             Name="Completed"
                             SeriesType="SeriesType.Bar"
                             XValue="@(d => d.Date.ToString("MMM dd", System.Globalization.CultureInfo.InvariantCulture))"
                             YValue="@(d => d.Completed)" />
            <ApexPointSeries TItem="DataPoint"
                             Items="DataPoints"
                             Name="Errors"
                             SeriesType="SeriesType.Bar"
                             XValue="@(d => d.Date.ToString("MMM dd", System.Globalization.CultureInfo.InvariantCulture))"
                             YValue="@(d => d.Errors)" />
        </ApexChart>
    }
</div>

@code {
    [Parameter]
    public List<DataPoint>? DataPoints { get; set; }

    public record DataPoint(DateTime Date, int Completed, int Errors);

    private readonly ApexChartOptions<DataPoint> _options = new()
    {
        Chart = new Chart
        {
            Stacked = true,
            Toolbar = new Toolbar { Show = false },
            FontFamily = "inherit",
        },
        Colors = new List<string> { "#415a77", "#dc2626" },
        PlotOptions = new PlotOptions
        {
            Bar = new PlotOptionsBar
            {
                BorderRadius = 2,
                ColumnWidth = "70%",
            }
        },
        DataLabels = new DataLabels { Enabled = false },
        Stroke = new Stroke { Show = false },
        Legend = new Legend
        {
            Position = LegendPosition.Top,
            HorizontalAlign = ApexCharts.Align.Left,
            FontSize = "12px",
        },
        Grid = new Grid { BorderColor = "#e5e7eb" },
    };
}
