@code {
    [Parameter] public int ConfigId { get; set; }

    // Config detail
    private ConfigurationDetailDto? _config;
    private string _name = "";
    private string _description = "";
    private int _version;
    private string _savedName = "";
    private string _savedDescription = "";
    private int _savedVersion;
    private bool _isSaving;
    private bool _isCloning;
    private List<string> _errorMessages = [];

    // Unsaved changes
    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<EditConfiguration>? _dotNetRef;
    private bool _showUnsavedDialog;
    private string? _pendingUri;

    // Delete config
    private bool _showDeleteConfigDialog;
    private string _deleteConfigConfirmText = "";
    private bool _isDeleting;
    private List<string> _deleteErrorMessages = [];

    // Table configurations
    private List<TableConfigDto>? _tableConfigs;
    private PaginationState _tablePagination = new() { ItemsPerPage = 10 };
    private string _tableSearchText = "";
    private bool _showTableDialog;
    private TableConfigDto? _editingTable;
    private string _tableName = "";
    private string _tableSchema = "";
    private int _tableSyncMode;
    private bool _tableSkipInitialSnapshot;
    private string _tableSelectIncrementalQuery = "";
    private string _tableCustomSnapshotQuery = "";
    private string _tableSkipColumns = "";
    private string _tableSkipColumnsOnInsertOrUpdate = "";
    private int _tableIdentityInsert;
    private bool _tableForceReloadInsertedRecords;
    private bool _isDialogSaving;
    private List<string> _dialogErrorMessages = [];

    // Selection & pending deletions
    private HashSet<int> _selectedTableIds = [];
    private HashSet<int> _pendingTableDeletions = [];

    // Bulk edit
    private bool _isBulkEdit;
    private List<TableConfigDto> _bulkEditTables = [];

    // Scaffold & Sort
    private bool _isScaffolding;
    private bool _isSorting;

    // Delete table
    private bool _showDeleteTableDialog;
    private TableConfigDto? _deletingTable;

    // Discovered tables (cached)
    private List<DiscoveredTableDto>? _discoveredTables;
    private bool _isLoadingDiscoveredTables;

    private List<DiscoveredTableDto>? _availableTables =>
        _discoveredTables?.Where(d =>
            _tableConfigs?.Any(t =>
                string.Equals(t.Name, d.Name, StringComparison.OrdinalIgnoreCase)
                && string.Equals(t.Schema ?? "", d.Schema ?? "", StringComparison.OrdinalIgnoreCase)) != true
        ).ToList();

    // Import
    private bool _showImportDialog;
    private bool _isImporting;
    private JsonElement[]? _importTables;
    private List<string> _importErrorMessages = [];

    // SQL preview
    private bool _showSqlPreview;
    private string _sqlPreviewTableName = "";
    private string _sqlPreviewIncrementalQuery = "";
    private string _sqlPreviewSnapshotQuery = "";

    private record ConfigurationDetailDto(int Id, string Name, string? Description, int Version, int DataStoreId, string DataStoreName, int DataStoreType, bool HasPublishedEndpoint, bool HasEndpoints);
    private record DiscoveredTableDto(string Name, string? Schema);
    private record TableConfigDto(
        int Id, string Name, string? Schema, int SyncMode, bool InError, int Sort, string? Message,
        bool SkipInitialSnapshot, string? SelectIncrementalQuery, string? CustomSnapshotQuery,
        string? SkipColumns, string? SkipColumnsOnInsertOrUpdate, int IdentityInsert,
        bool ForceReloadInsertedRecords);

    private bool IsSqlServer => _config?.DataStoreType == 1;
    private bool IsPublished => _config?.HasPublishedEndpoint == true;
    private bool IsTableConfigLocked => IsPublished;

    private bool HasUnsavedChanges =>
        _name != _savedName || _description != _savedDescription || _version != _savedVersion
        || _pendingTableDeletions.Count > 0;

    private IQueryable<TableConfigDto>? _filteredTableConfigs =>
        _tableConfigs?.Where(t =>
            !_pendingTableDeletions.Contains(t.Id)
            && (string.IsNullOrEmpty(_tableSearchText)
                || t.Name.Contains(_tableSearchText, StringComparison.OrdinalIgnoreCase)
                || (t.Schema?.Contains(_tableSearchText, StringComparison.OrdinalIgnoreCase) ?? false))
        ).AsQueryable();

    protected override async Task OnInitializedInteractiveAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/unsavedChangesGuard.js");
        await _jsModule.InvokeVoidAsync("register", _dotNetRef);
        await LoadConfiguration();
        await LoadTableConfigs();
    }

    private async Task LoadConfiguration()
    {
        _config = await Http.GetFromJsonAsync<ConfigurationDetailDto>($"api/datastoreconfigurations/{ConfigId}");
        if (_config is not null)
        {
            _name = _savedName = _config.Name;
            _description = _savedDescription = _config.Description ?? "";
            _version = _savedVersion = _config.Version;
        }
    }

    private async Task LoadTableConfigs()
    {
        _tableConfigs = await Http.GetFromJsonAsync<List<TableConfigDto>>($"api/datastoreconfigurations/{ConfigId}/tables");
    }

    // Unsaved changes
    private void NavigateBack()
    {
        if (HasUnsavedChanges)
        {
            _pendingUri = $"/data-stores/{_config!.DataStoreId}/edit";
            _showUnsavedDialog = true;
        }
        else
        {
            NavigationManager.NavigateTo($"/data-stores/{_config!.DataStoreId}/edit");
        }
    }

    [JSInvokable]
    public void OnNavigationAttempted(string href)
    {
        if (HasUnsavedChanges)
        {
            _pendingUri = href;
            _showUnsavedDialog = true;
            StateHasChanged();
        }
        else
        {
            NavigationManager.NavigateTo(href);
        }
    }

    private void DiscardAndNavigate()
    {
        _showUnsavedDialog = false;
        NavigationManager.NavigateTo(_pendingUri!);
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("unregister");
            await _jsModule.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }

    // Save configuration
    private async Task SaveConfiguration()
    {
        _isSaving = true;
        _errorMessages = [];

        try
        {
            var request = new
            {
                Name = _name.Trim(),
                Description = string.IsNullOrWhiteSpace(_description) ? (string?)null : _description.Trim(),
                Version = _version
            };

            var response = await Http.PutAsJsonAsync($"api/datastoreconfigurations/{ConfigId}", request);

            if (response.IsSuccessStatusCode)
            {
                _savedName = _name.Trim();
                _savedDescription = _description;
                _savedVersion = _version;
                _config = _config! with { Name = _savedName, Description = _savedDescription, Version = _savedVersion };
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                _errorMessages = errors ?? ["An unexpected error occurred."];
                return;
            }

            // Process pending table deletions
            if (_pendingTableDeletions.Count > 0)
            {
                var deleteErrors = new List<string>();

                foreach (var tableId in _pendingTableDeletions)
                {
                    var deleteResponse = await Http.DeleteAsync($"api/datastoreconfigurations/{ConfigId}/tables/{tableId}");
                    if (!deleteResponse.IsSuccessStatusCode)
                    {
                        var errors = await deleteResponse.Content.ReadFromJsonAsync<List<string>>();
                        deleteErrors.AddRange(errors ?? [$"Failed to delete table {tableId}."]);
                    }
                }

                _pendingTableDeletions.Clear();
                _selectedTableIds.Clear();
                await LoadTableConfigs();

                if (deleteErrors.Count > 0)
                {
                    _errorMessages = deleteErrors;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessages = [ex.Message];
        }
        finally
        {
            _isSaving = false;
        }
    }

    // Clone configuration
    private async Task CloneConfiguration()
    {
        _isCloning = true;
        _errorMessages = [];

        try
        {
            var response = await Http.PostAsync($"api/datastoreconfigurations/{ConfigId}/clone", null);

            if (response.IsSuccessStatusCode)
            {
                var cloned = await response.Content.ReadFromJsonAsync<ConfigurationDetailDto>();
                if (cloned is not null)
                    NavigationManager.NavigateTo($"/data-stores/configurations/edit/{cloned.Id}");
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                _errorMessages = errors ?? ["An unexpected error occurred."];
            }
        }
        catch (Exception ex)
        {
            _errorMessages = [ex.Message];
        }
        finally
        {
            _isCloning = false;
        }
    }

    // Delete configuration
    private void OpenDeleteConfigDialog()
    {
        _deleteConfigConfirmText = "";
        _deleteErrorMessages = [];
        _showDeleteConfigDialog = true;
    }

    private async Task DeleteConfiguration()
    {
        _isDeleting = true;
        _deleteErrorMessages = [];

        try
        {
            var response = await Http.DeleteAsync($"api/datastoreconfigurations/{ConfigId}");

            if (response.IsSuccessStatusCode)
            {
                _showDeleteConfigDialog = false;
                NavigationManager.NavigateTo($"/data-stores/{_config!.DataStoreId}/edit");
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                _deleteErrorMessages = errors ?? ["An unexpected error occurred."];
            }
        }
        catch (Exception ex)
        {
            _deleteErrorMessages = [ex.Message];
        }
        finally
        {
            _isDeleting = false;
        }
    }

    // Table selection
    private bool AllVisibleTablesSelected =>
        _filteredTableConfigs is not null
        && _filteredTableConfigs.Any()
        && _filteredTableConfigs.All(t => _selectedTableIds.Contains(t.Id));

    private void ToggleTableSelection(int tableId)
    {
        if (!_selectedTableIds.Remove(tableId))
            _selectedTableIds.Add(tableId);
    }

    private void ToggleSelectAllTables()
    {
        if (_filteredTableConfigs is null) return;

        if (AllVisibleTablesSelected)
        {
            foreach (var t in _filteredTableConfigs)
                _selectedTableIds.Remove(t.Id);
        }
        else
        {
            foreach (var t in _filteredTableConfigs)
                _selectedTableIds.Add(t.Id);
        }
    }

    private void MarkSelectedTablesForDeletion()
    {
        _pendingTableDeletions.UnionWith(_selectedTableIds);
        _selectedTableIds.Clear();
    }

    // Sync mode helpers
    private static string GetSyncModeLabel(int mode) => mode switch
    {
        0 => "Upload & Download",
        1 => "Upload Only",
        2 => "Download Only",
        3 => "Not Tracked",
        _ => "Unknown"
    };

    private static string GetSyncModeStyle(int mode) => mode switch
    {
        0 => "bg-dusk-blue-900 text-dusk-blue-500",
        1 => "bg-green-100 text-green-700",
        2 => "bg-purple-100 text-purple-700",
        3 => "bg-gray-100 text-gray-500",
        _ => "bg-gray-100 text-gray-700"
    };

    private static string GetIdentityInsertLabel(int mode) => mode switch
    {
        0 => "Auto",
        1 => "On",
        2 => "Off",
        3 => "Disabled",
        _ => "Unknown"
    };

    // JSON array <-> comma-separated helpers
    private static string JsonArrayToCommaSeparated(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return "";
        try
        {
            var arr = JsonSerializer.Deserialize<string[]>(json);
            return arr is not null ? string.Join(", ", arr) : "";
        }
        catch
        {
            return "";
        }
    }

    private static string? CommaSeparatedToJsonArray(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return null;
        var items = input.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(s => s.Length > 0)
            .ToArray();
        return items.Length > 0 ? JsonSerializer.Serialize(items) : null;
    }

    private static int GetSkipColumnsCount(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return 0;
        try
        {
            var arr = JsonSerializer.Deserialize<string[]>(json);
            return arr?.Length ?? 0;
        }
        catch
        {
            return 0;
        }
    }

    private bool IsDialogSaveDisabled =>
        _isBulkEdit ? false
        : _editingTable is null ? _selectedNewTables.Count == 0
        : string.IsNullOrWhiteSpace(_tableName);

    // Add table multi-select
    private HashSet<string> _selectedNewTables = [];
    private string _newTableSearchText = "";

    private IEnumerable<DiscoveredTableDto> _filteredAvailableTables =>
        (_availableTables ?? []).Where(t =>
        {
            if (string.IsNullOrEmpty(_newTableSearchText)) return true;
            var label = string.IsNullOrEmpty(t.Schema) ? t.Name : $"{t.Schema}.{t.Name}";
            return label.Contains(_newTableSearchText, StringComparison.OrdinalIgnoreCase);
        });

    private void ToggleNewTableSelection(string key)
    {
        if (!_selectedNewTables.Remove(key))
            _selectedNewTables.Add(key);
    }

    private void ToggleSelectAllNewTables()
    {
        if (_availableTables is null) return;

        if (_selectedNewTables.Count == _availableTables.Count)
        {
            _selectedNewTables.Clear();
        }
        else
        {
            _selectedNewTables = _availableTables.Select(t => $"{t.Schema}|{t.Name}").ToHashSet();
        }
    }

    // SQL preview
    private void ShowSqlPreview(TableConfigDto table)
    {
        _sqlPreviewTableName = table.Name;
        _sqlPreviewIncrementalQuery = table.SelectIncrementalQuery ?? "";
        _sqlPreviewSnapshotQuery = table.CustomSnapshotQuery ?? "";
        _showSqlPreview = true;
    }

    // Table config CRUD
    private async Task OpenCreateTableDialog()
    {
        _editingTable = null;
        _tableName = "";
        _tableSchema = "";
        _tableSyncMode = 0;
        _tableSkipInitialSnapshot = false;
        _tableSelectIncrementalQuery = "";
        _tableCustomSnapshotQuery = "";
        _tableSkipColumns = "";
        _tableSkipColumnsOnInsertOrUpdate = "";
        _tableIdentityInsert = 0;
        _tableForceReloadInsertedRecords = false;
        _selectedNewTables = [];
        _newTableSearchText = "";
        _dialogErrorMessages = [];
        _showTableDialog = true;

        if (_discoveredTables is null)
        {
            _isLoadingDiscoveredTables = true;
            try
            {
                _discoveredTables = await Http.GetFromJsonAsync<List<DiscoveredTableDto>>($"api/datastoreconfigurations/{ConfigId}/tables/discover");
            }
            catch
            {
                _discoveredTables = [];
            }
            finally
            {
                _isLoadingDiscoveredTables = false;
            }
        }
    }

    private void OpenEditTableDialog(TableConfigDto table)
    {
        _isBulkEdit = _selectedTableIds.Count > 1 && _selectedTableIds.Contains(table.Id);

        if (_isBulkEdit)
        {
            _bulkEditTables = _tableConfigs!.Where(t => _selectedTableIds.Contains(t.Id)).ToList();
        }

        _editingTable = table;
        _tableName = table.Name;
        _tableSchema = table.Schema ?? "";
        _tableSyncMode = table.SyncMode;
        _tableSkipInitialSnapshot = table.SkipInitialSnapshot;
        _tableSelectIncrementalQuery = table.SelectIncrementalQuery ?? "";
        _tableCustomSnapshotQuery = table.CustomSnapshotQuery ?? "";
        _tableSkipColumns = JsonArrayToCommaSeparated(table.SkipColumns);
        _tableSkipColumnsOnInsertOrUpdate = JsonArrayToCommaSeparated(table.SkipColumnsOnInsertOrUpdate);
        _tableIdentityInsert = table.IdentityInsert;
        _tableForceReloadInsertedRecords = table.ForceReloadInsertedRecords;
        _dialogErrorMessages = [];
        _showTableDialog = true;
    }

    private void CloseTableDialog()
    {
        _showTableDialog = false;
        _editingTable = null;
        _isBulkEdit = false;
        _bulkEditTables = [];
        _dialogErrorMessages = [];
    }

    private async Task SaveTable()
    {
        _isDialogSaving = true;
        _dialogErrorMessages = [];

        try
        {
            if (_isBulkEdit)
            {
                var errors = new List<string>();

                foreach (var table in _bulkEditTables)
                {
                    var request = new
                    {
                        Name = table.Name,
                        Schema = table.Schema,
                        SyncMode = _tableSyncMode,
                        SkipInitialSnapshot = _tableSkipInitialSnapshot,
                        SelectIncrementalQuery = string.IsNullOrWhiteSpace(_tableSelectIncrementalQuery) ? (string?)null : _tableSelectIncrementalQuery.Trim(),
                        CustomSnapshotQuery = string.IsNullOrWhiteSpace(_tableCustomSnapshotQuery) ? (string?)null : _tableCustomSnapshotQuery.Trim(),
                        SkipColumns = CommaSeparatedToJsonArray(_tableSkipColumns),
                        SkipColumnsOnInsertOrUpdate = CommaSeparatedToJsonArray(_tableSkipColumnsOnInsertOrUpdate),
                        IdentityInsert = _tableIdentityInsert,
                        ForceReloadInsertedRecords = _tableForceReloadInsertedRecords
                    };

                    var response = await Http.PutAsJsonAsync($"api/datastoreconfigurations/{ConfigId}/tables/{table.Id}", request);
                    if (!response.IsSuccessStatusCode)
                    {
                        var tableErrors = await response.Content.ReadFromJsonAsync<List<string>>();
                        errors.AddRange((tableErrors ?? [$"Failed to update {table.Name}."]).Select(e => $"{table.Name}: {e}"));
                    }
                }

                if (errors.Count > 0)
                {
                    _dialogErrorMessages = errors;
                }
                else
                {
                    _selectedTableIds.Clear();
                    CloseTableDialog();
                    await LoadTableConfigs();
                }
            }
            else if (_editingTable is not null)
            {
                var request = new
                {
                    Name = _tableName.Trim(),
                    Schema = string.IsNullOrWhiteSpace(_tableSchema) ? (string?)null : _tableSchema.Trim(),
                    SyncMode = _tableSyncMode,
                    SkipInitialSnapshot = _tableSkipInitialSnapshot,
                    SelectIncrementalQuery = string.IsNullOrWhiteSpace(_tableSelectIncrementalQuery) ? (string?)null : _tableSelectIncrementalQuery.Trim(),
                    CustomSnapshotQuery = string.IsNullOrWhiteSpace(_tableCustomSnapshotQuery) ? (string?)null : _tableCustomSnapshotQuery.Trim(),
                    SkipColumns = CommaSeparatedToJsonArray(_tableSkipColumns),
                    SkipColumnsOnInsertOrUpdate = CommaSeparatedToJsonArray(_tableSkipColumnsOnInsertOrUpdate),
                    IdentityInsert = _tableIdentityInsert,
                    ForceReloadInsertedRecords = _tableForceReloadInsertedRecords
                };

                var response = await Http.PutAsJsonAsync($"api/datastoreconfigurations/{ConfigId}/tables/{_editingTable.Id}", request);

                if (response.IsSuccessStatusCode)
                {
                    CloseTableDialog();
                    await LoadTableConfigs();
                }
                else
                {
                    var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                    _dialogErrorMessages = errors ?? ["An unexpected error occurred."];
                }
            }
            else
            {
                var errors = new List<string>();

                foreach (var key in _selectedNewTables)
                {
                    var parts = key.Split('|', 2);
                    var schema = parts[0];
                    var name = parts[1];

                    var request = new
                    {
                        Name = name,
                        Schema = string.IsNullOrEmpty(schema) ? (string?)null : schema,
                        SyncMode = _tableSyncMode,
                        SkipInitialSnapshot = _tableSkipInitialSnapshot,
                        SelectIncrementalQuery = string.IsNullOrWhiteSpace(_tableSelectIncrementalQuery) ? (string?)null : _tableSelectIncrementalQuery.Trim(),
                        CustomSnapshotQuery = string.IsNullOrWhiteSpace(_tableCustomSnapshotQuery) ? (string?)null : _tableCustomSnapshotQuery.Trim(),
                        SkipColumns = CommaSeparatedToJsonArray(_tableSkipColumns),
                        SkipColumnsOnInsertOrUpdate = CommaSeparatedToJsonArray(_tableSkipColumnsOnInsertOrUpdate),
                        IdentityInsert = _tableIdentityInsert,
                        ForceReloadInsertedRecords = _tableForceReloadInsertedRecords
                    };

                    var response = await Http.PostAsJsonAsync($"api/datastoreconfigurations/{ConfigId}/tables", request);
                    if (!response.IsSuccessStatusCode)
                    {
                        var tableErrors = await response.Content.ReadFromJsonAsync<List<string>>();
                        errors.AddRange((tableErrors ?? [$"Failed to add {name}."]).Select(e => $"{name}: {e}"));
                    }
                }

                if (errors.Count > 0)
                {
                    _dialogErrorMessages = errors;
                }

                CloseTableDialog();
                await LoadTableConfigs();
            }
        }
        catch (Exception ex)
        {
            _dialogErrorMessages = [ex.Message];
        }
        finally
        {
            _isDialogSaving = false;
        }
    }

    private void OpenDeleteTableDialog(TableConfigDto table)
    {
        _deletingTable = table;
        _dialogErrorMessages = [];
        _showDeleteTableDialog = true;
    }

    private async Task DeleteTable()
    {
        _isDialogSaving = true;
        _dialogErrorMessages = [];

        try
        {
            var response = await Http.DeleteAsync($"api/datastoreconfigurations/{ConfigId}/tables/{_deletingTable!.Id}");

            if (response.IsSuccessStatusCode)
            {
                _showDeleteTableDialog = false;
                _selectedTableIds.Remove(_deletingTable!.Id);
                _pendingTableDeletions.Remove(_deletingTable.Id);
                _deletingTable = null;
                await LoadTableConfigs();
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                _dialogErrorMessages = errors ?? ["An unexpected error occurred."];
            }
        }
        catch (Exception ex)
        {
            _dialogErrorMessages = [ex.Message];
        }
        finally
        {
            _isDialogSaving = false;
        }
    }

