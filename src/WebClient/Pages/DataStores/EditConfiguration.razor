    // Import
    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        _importErrorMessages = [];
        _importTables = null;

        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var json = await JsonSerializer.DeserializeAsync<JsonElement>(stream);

            if (json.TryGetProperty("tables", out var tablesElement) && tablesElement.ValueKind == JsonValueKind.Array)
            {
                _importTables = tablesElement.EnumerateArray().ToArray();

                if (_importTables.Length == 0)
                {
                    _importErrorMessages = ["The JSON file contains no tables."];
                    return;
                }

                _showImportDialog = true;
            }
            else
            {
                _errorMessages = ["Invalid JSON format: missing 'tables' array."];
            }
        }
        catch (Exception ex)
        {
            _errorMessages = [$"Failed to read file: {ex.Message}"];
        }
    }

    private async Task ConfirmImport()
    {
        if (_importTables is null) return;

        _isImporting = true;
        _importErrorMessages = [];

        try
        {
            var tables = _importTables.Select(t =>
            {
                var name = t.GetProperty("name").GetString() ?? "";
                string? schema = t.TryGetProperty("schema", out var s) ? s.GetString() : null;
                string? syncDirection = t.TryGetProperty("syncDirection", out var sd) ? sd.GetString() : null;
                int? syncMode = t.TryGetProperty("syncMode", out var sm) && sm.ValueKind == JsonValueKind.Number ? sm.GetInt32() : null;
                bool skipInitialSnapshot = t.TryGetProperty("skipInitialSnapshot", out var si) && si.GetBoolean();
                string? selectIncrementalQuery = t.TryGetProperty("selectIncrementalQuery", out var siq) ? siq.GetString() : null;
                string? customSnapshotQuery = t.TryGetProperty("customSnapshotQuery", out var csq) ? csq.GetString() : null;
                string? skipColumns = t.TryGetProperty("skipColumns", out var sc) && sc.ValueKind != JsonValueKind.Null
                    ? (sc.ValueKind == JsonValueKind.Array ? sc.GetRawText() : sc.GetString()) : null;
                string? skipColumnsOnInsertOrUpdate = t.TryGetProperty("skipColumnsOnInsertOrUpdate", out var sciu) && sciu.ValueKind != JsonValueKind.Null
                    ? (sciu.ValueKind == JsonValueKind.Array ? sciu.GetRawText() : sciu.GetString()) : null;
                int identityInsert = 0;
                if (t.TryGetProperty("identityInsert", out var ii))
                {
                    if (ii.ValueKind == JsonValueKind.Number)
                        identityInsert = ii.GetInt32();
                    else if (ii.ValueKind == JsonValueKind.String)
                        identityInsert = ii.GetString() switch { "On" => 1, "Off" => 2, "Disabled" => 3, _ => 0 };
                }
                bool forceReloadInsertedRecords = t.TryGetProperty("forceReloadInsertedRecords", out var fr) && fr.ValueKind == JsonValueKind.True;

                return new
                {
                    Name = name,
                    Schema = schema,
                    SyncDirection = syncDirection,
                    SyncMode = syncMode,
                    SkipInitialSnapshot = skipInitialSnapshot,
                    SelectIncrementalQuery = selectIncrementalQuery,
                    CustomSnapshotQuery = customSnapshotQuery,
                    SkipColumns = skipColumns,
                    SkipColumnsOnInsertOrUpdate = skipColumnsOnInsertOrUpdate,
                    IdentityInsert = identityInsert,
                    ForceReloadInsertedRecords = forceReloadInsertedRecords
                };
            }).ToArray();

            var request = new { Tables = tables };
            var response = await Http.PostAsJsonAsync($"api/datastoreconfigurations/{ConfigId}/tables/import", request);

            if (response.IsSuccessStatusCode)
            {
                _tableConfigs = await response.Content.ReadFromJsonAsync<List<TableConfigDto>>();
                _selectedTableIds.Clear();
                _pendingTableDeletions.Clear();
                _showImportDialog = false;
                _importTables = null;
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                _importErrorMessages = errors ?? ["An unexpected error occurred."];
            }
        }
        catch (Exception ex)
        {
            _importErrorMessages = [ex.Message];
        }
        finally
        {
            _isImporting = false;
        }
    }

