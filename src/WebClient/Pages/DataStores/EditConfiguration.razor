@page "/data-stores/configurations/edit/{ConfigId:int}"
@attribute [Authorize]
@inherits InteractivePage
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@layout DashboardLayout
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization
@using System.Text.Json

<PageTitle>Edit Configuration</PageTitle>

@if (_config is null)
{
    <div class="flex items-center justify-center py-12">
        <div class="flex items-center gap-3 text-gray-500">
            <div class="w-5 h-5 border-2 border-gray-300 border-t-dusk-blue-500 rounded-full animate-spin"></div>
            <span class="text-sm">Loading configuration...</span>
        </div>
    </div>
}
else
{
    <div class="space-y-6">
        @* Header *@
        <div>
            <button @onclick="NavigateBack"
                    class="text-sm text-dusk-blue-500 hover:text-dusk-blue-600 hover:underline flex items-center gap-1 mb-2">
                <span class="i-lucide-arrow-left size-3.5"></span>
                Back to Data Store
            </button>
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900">Edit Configuration</h1>
                    <p class="text-gray-500 mt-1">@_config.DataStoreName</p>
                </div>
                <div class="flex items-center gap-3">
                    <button @onclick="OpenDeleteConfigDialog"
                            class="bg-red-600 hover:bg-red-700 text-white font-medium py-2 px-4 rounded-lg transition-colors text-sm flex items-center gap-2">
                        <span class="i-lucide-trash-2 size-4"></span>
                        Delete
                    </button>
                    <button @onclick="CloneConfiguration" disabled="@_isCloning"
                            class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-4 rounded-lg transition-colors text-sm flex items-center gap-2 disabled:opacity-50">
                        <span class="i-lucide-copy size-4"></span>
                        @(_isCloning ? "Cloning..." : "Clone")
                    </button>
                    <label for="importFileInput"
                           class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-medium py-2 px-4 rounded-lg transition-colors text-sm flex items-center gap-2 cursor-pointer @(IsPublished ? "opacity-50 pointer-events-none" : "")"
                           title="@(IsPublished ? "Cannot import while an endpoint is published" : "Import configuration from JSON")">
                        <span class="i-lucide-upload size-4"></span>
                        Import
                    </label>
                    <InputFile OnChange="OnImportFileSelected" accept=".json" id="importFileInput" class="hidden" />
                    <div class="h-8 w-px bg-gray-200"></div>
                    <button @onclick="SaveConfiguration" disabled="@(!HasUnsavedChanges || _isSaving)"
                            class="bg-dusk-blue-500 hover:bg-dusk-blue-600 text-white font-medium py-2 px-4 rounded-lg transition-colors text-sm flex items-center gap-2 disabled:opacity-50">
                        <span class="i-lucide-save size-4"></span>
                        @(_isSaving ? "Saving..." : "Save")
                    </button>
                </div>
            </div>
        </div>

        @* Form card *@
        <div class="bg-white rounded-lg border border-gray-200 p-6">
            @if (_errorMessages.Count > 0)
            {
                <div class="mb-4 p-3 bg-ink-black-900 border border-ink-black-700 rounded-lg">
                    @foreach (var error in _errorMessages)
                    {
                        <p class="text-sm text-ink-black-500">@error</p>
                    }
                </div>
            }

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                    <input type="text" @bind="_name" placeholder="Configuration name"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Version</label>
                    <input type="number" @bind="_version" min="1" disabled="@IsPublished"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors disabled:bg-gray-50 disabled:text-gray-500" />
                    @if (IsPublished)
                    {
                        <p class="text-xs text-amber-600 mt-1">Version is locked while an endpoint is published.</p>
                    }
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea @bind="_description" rows="3" placeholder="Optional description"
                              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors resize-none"></textarea>
                </div>
            </div>
        </div>

        @* Table Configurations *@
        <div>
            <DataGrid Loading="@(_tableConfigs is null)"
                              LoadingMessage="Loading table configurations..."
                              EmptyIcon="i-lucide-table"
                              EmptyMessage="No table configurations yet."
                              ItemCount="@(_filteredTableConfigs?.Count() ?? 0)"
                              Pagination="@_tablePagination"
                              FilterPlaceholder="Search tables..."
                              FilterText="@_tableSearchText"
                              FilterTextChanged="@(v => _tableSearchText = v)"
                              OnRefresh="@LoadTableConfigs">
                        <ToolbarContent>
                            @if (IsTableConfigLocked)
                            {
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium bg-amber-50 text-amber-700 border border-amber-200">
                                    <span class="i-lucide-lock size-3.5"></span>
                                    Locked (published endpoint)
                                </span>
                            }
                            else
                            {
                                <button @onclick="OpenCreateTableDialog"
                                        class="bg-dusk-blue-500 hover:bg-dusk-blue-600 text-white font-medium py-1.5 px-3 rounded-lg transition-colors text-sm flex items-center gap-1.5">
                                    <span class="i-lucide-plus size-3.5"></span>
                                    Add Table
                                </button>
                                <button @onclick="ScaffoldTables" disabled="@(_isScaffolding || HasUnsavedChanges)"
                                        class="bg-gray-600 hover:bg-gray-700 text-white font-medium py-1.5 px-3 rounded-lg transition-colors text-sm flex items-center gap-1.5 disabled:opacity-50">
                                    <span class="i-lucide-database size-3.5"></span>
                                    @(_isScaffolding ? "Scaffolding..." : "Scaffold")
                                </button>
                                <button @onclick="SortTables" disabled="@(_isSorting || HasUnsavedChanges)"
                                        class="bg-gray-600 hover:bg-gray-700 text-white font-medium py-1.5 px-3 rounded-lg transition-colors text-sm flex items-center gap-1.5 disabled:opacity-50">
                                    <span class="i-lucide-arrow-up-down size-3.5"></span>
                                    @(_isSorting ? "Sorting..." : "Sort")
                                </button>
                                @if (_selectedTableIds.Count > 0)
                                {
                                    <div class="h-6 w-px bg-gray-300"></div>
                                    <button @onclick="MarkSelectedTablesForDeletion"
                                            class="bg-red-600 hover:bg-red-700 text-white font-medium py-1.5 px-3 rounded-lg transition-colors text-sm flex items-center gap-1.5">
                                        <span class="i-lucide-trash-2 size-3.5"></span>
                                        Delete Selected (@_selectedTableIds.Count)
                                    </button>
                                }
                            }
                        </ToolbarContent>
                        <ChildContent>
                            <QuickGrid Items="@_filteredTableConfigs" Pagination="@_tablePagination" Theme="custom">
                                <TemplateColumn Class="@(IsTableConfigLocked ? "hidden" : "w-12")" Align="Align.Center">
                                    <HeaderTemplate>
                                        @if (!IsTableConfigLocked && _filteredTableConfigs?.Any() == true)
                                        {
                                            <input type="checkbox"
                                                   checked="@AllVisibleTablesSelected"
                                                   @onchange="ToggleSelectAllTables"
                                                   class="size-4 rounded border-gray-300 text-dusk-blue-500 focus:ring-dusk-blue-500 cursor-pointer" />
                                        }
                                    </HeaderTemplate>
                                    <ChildContent>
                                        @if (!IsTableConfigLocked)
                                        {
                                            <input type="checkbox"
                                                   checked="@_selectedTableIds.Contains(context.Id)"
                                                   @onchange="() => ToggleTableSelection(context.Id)"
                                                   class="size-4 rounded border-gray-300 text-dusk-blue-500 focus:ring-dusk-blue-500 cursor-pointer" />
                                        }
                                    </ChildContent>
                                </TemplateColumn>
                                <TemplateColumn Title="Sort" SortBy="@(GridSort<TableConfigDto>.ByAscending(t => t.Sort))" IsDefaultSortColumn="true">
                                    <span class="text-sm text-gray-500">@context.Sort</span>
                                </TemplateColumn>
                                <TemplateColumn Title="Name" SortBy="@(GridSort<TableConfigDto>.ByAscending(t => t.Name))">
                                    <span class="text-sm font-medium text-gray-900">@context.Name</span>
                                </TemplateColumn>
                                <TemplateColumn Title="Schema" SortBy="@(GridSort<TableConfigDto>.ByAscending(t => t.Schema))">
                                    <span class="text-sm text-gray-700">@(context.Schema ?? "—")</span>
                                </TemplateColumn>
                                <TemplateColumn Title="Sync Mode" SortBy="@(GridSort<TableConfigDto>.ByAscending(t => t.SyncMode))">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetSyncModeStyle(context.SyncMode)">
                                        @GetSyncModeLabel(context.SyncMode)
                                    </span>
                                </TemplateColumn>
                                <TemplateColumn Title="Options">
                                    <div class="flex items-center gap-1 flex-wrap">
                                        @if (context.SkipInitialSnapshot)
                                        {
                                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">SKIP SNAPSHOT</span>
                                        }
                                        @if (!string.IsNullOrEmpty(context.SelectIncrementalQuery) || !string.IsNullOrEmpty(context.CustomSnapshotQuery))
                                        {
                                            <button @onclick="() => ShowSqlPreview(context)" @onclick:stopPropagation="true"
                                                    class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-dusk-blue-900 text-dusk-blue-500 hover:bg-dusk-blue-800 cursor-pointer transition-colors">
                                                <span class="i-lucide-code size-3 mr-1"></span>
                                                CUSTOM SQL
                                            </button>
                                        }
                                        @if (IsSqlServer)
                                        {
                                            @if (GetSkipColumnsCount(context.SkipColumns) > 0)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">@GetSkipColumnsCount(context.SkipColumns) skip cols</span>
                                            }
                                            @if (context.IdentityInsert != 0)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-700">ID: @GetIdentityInsertLabel(context.IdentityInsert)</span>
                                            }
                                            @if (context.ForceReloadInsertedRecords)
                                            {
                                                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">FORCE RELOAD</span>
                                            }
                                        }
                                    </div>
                                </TemplateColumn>
                                <TemplateColumn Title="Status" SortBy="@(GridSort<TableConfigDto>.ByDescending(t => t.InError))">
                                    @if (context.InError)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-700" title="@context.Message">ERROR</span>
                                    }
                                    else if (context.Message is not null)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">@context.Message</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700">OK</span>
                                    }
                                </TemplateColumn>
                                <TemplateColumn Title="Actions" Align="Align.End">
                                    @if (!IsTableConfigLocked)
                                    {
                                        <div class="flex items-center justify-end gap-1">
                                            <button @onclick="() => OpenEditTableDialog(context)"
                                                    class="p-2 rounded-lg text-gray-400 hover:text-dusk-blue-500 hover:bg-gray-100 transition-colors"
                                                    title="Edit table">
                                                <span class="i-lucide-pencil size-4"></span>
                                            </button>
                                            <button @onclick="() => OpenDeleteTableDialog(context)"
                                                    class="p-2 rounded-lg text-gray-400 hover:text-ink-black-500 hover:bg-gray-100 transition-colors"
                                                    title="Delete table">
                                                <span class="i-lucide-trash-2 size-4"></span>
                                            </button>
                                        </div>
                                    }
                                </TemplateColumn>
                            </QuickGrid>
                        </ChildContent>
                    </DataGrid>
        </div>

    </div>
}

@* Unsaved changes dialog *@
@if (_showUnsavedDialog)
{
    <div class="fixed inset-0 z-40 bg-black/50" @onclick="() => _showUnsavedDialog = false"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded border border-gray-200 w-full max-w-md" @onclick:stopPropagation="true">
            <div class="p-6">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-ink-black-900 flex items-center justify-center">
                        <span class="i-lucide-alert-triangle size-5 text-ink-black-500"></span>
                    </div>
                    <h2 class="text-lg font-semibold text-gray-900">Unsaved Changes</h2>
                </div>
                <p class="text-sm text-gray-600 mb-6">
                    You have unsaved changes. Are you sure you want to leave this page? Your changes will be lost.
                </p>
                <div class="flex justify-end gap-3">
                    <button @onclick="() => _showUnsavedDialog = false"
                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
                        Stay
                    </button>
                    <button @onclick="DiscardAndNavigate"
                            class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors">
                        Discard Changes
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Delete configuration dialog *@
@if (_showDeleteConfigDialog)
{
    <div class="fixed inset-0 z-40 bg-black/50" @onclick="() => _showDeleteConfigDialog = false"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded border border-gray-200 w-full max-w-md" @onclick:stopPropagation="true">
            <div class="p-6">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-ink-black-900 flex items-center justify-center">
                        <span class="i-lucide-alert-triangle size-5 text-ink-black-500"></span>
                    </div>
                    <h2 class="text-lg font-semibold text-gray-900">Delete Configuration</h2>
                </div>
                <p class="text-sm text-gray-600 mb-2">
                    This will permanently delete <strong>@_config?.Name</strong> and all associated table configurations and endpoints. This action cannot be undone.
                </p>
                <p class="text-sm text-gray-600 mb-4">
                    Type <strong>@_config?.Name</strong> to confirm:
                </p>
                <input type="text" @bind="_deleteConfigConfirmText" placeholder="Enter configuration name"
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ink-black-500 focus:border-ink-black-500 outline-none transition-colors mb-4" />

                @if (_deleteErrorMessages.Count > 0)
                {
                    <div class="mb-4 p-3 bg-ink-black-900 border border-ink-black-700 rounded-lg">
                        @foreach (var error in _deleteErrorMessages)
                        {
                            <p class="text-sm text-ink-black-500">@error</p>
                        }
                    </div>
                }

                <div class="flex justify-end gap-3">
                    <button @onclick="() => _showDeleteConfigDialog = false"
                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
                        Cancel
                    </button>
                    <button @onclick="DeleteConfiguration" disabled="@(_isDeleting || _deleteConfigConfirmText != _config?.Name)"
                            class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors disabled:opacity-50">
                        @(_isDeleting ? "Deleting..." : "Delete Configuration")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Create/Edit table config dialog *@
@if (_showTableDialog)
{
    <div class="fixed inset-0 z-40 bg-black/50" @onclick="CloseTableDialog"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded border border-gray-200 w-full max-w-2xl max-h-[90vh] overflow-y-auto" @onclick:stopPropagation="true">
            <div class="p-6">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-10 h-10 rounded-lg bg-dusk-blue-900 flex items-center justify-center">
                        <span class="@(_isBulkEdit ? "i-lucide-pencil-ruler" : "i-lucide-table") size-5 text-dusk-blue-500"></span>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">
                            @if (_isBulkEdit)
                            {
                                @($"Edit {_bulkEditTables.Count} Tables")
                            }
                            else
                            {
                                @(_editingTable is null ? "Add Table Configuration" : "Edit Table Configuration")
                            }
                        </h2>
                        @if (_isBulkEdit)
                        {
                            <p class="text-sm text-gray-500 mt-0.5">
                                @string.Join(", ", _bulkEditTables.Select(t => t.Name))
                            </p>
                        }
                    </div>
                </div>

                <div class="space-y-4">
                    @if (!_isBulkEdit)
                    {
                        @if (_editingTable is null && _availableTables is { Count: > 0 })
                        {
                            <div>
                                <div class="flex items-center justify-between mb-1">
                                    <label class="block text-sm font-medium text-gray-700">Tables (@_selectedNewTables.Count selected)</label>
                                    @if (_availableTables.Count > 0)
                                    {
                                        <button type="button" @onclick="ToggleSelectAllNewTables"
                                                class="text-xs text-dusk-blue-500 hover:text-dusk-blue-600">
                                            @(_selectedNewTables.Count == _availableTables.Count ? "Deselect all" : "Select all")
                                        </button>
                                    }
                                </div>
                                <input type="text" @bind="_newTableSearchText" @bind:event="oninput" placeholder="Filter tables..."
                                       class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors text-sm mb-2" />
                                <div class="border border-gray-200 rounded-lg max-h-48 overflow-y-auto">
                                    @foreach (var t in _filteredAvailableTables)
                                    {
                                        var key = $"{t.Schema}|{t.Name}";
                                        var label = string.IsNullOrEmpty(t.Schema) ? t.Name : $"{t.Schema}.{t.Name}";
                                        <label class="flex items-center gap-2 px-3 py-1.5 hover:bg-gray-50 cursor-pointer">
                                            <input type="checkbox"
                                                   checked="@_selectedNewTables.Contains(key)"
                                                   @onchange="() => ToggleNewTableSelection(key)"
                                                   class="size-4 rounded border-gray-300 text-dusk-blue-500 focus:ring-dusk-blue-500" />
                                            <span class="text-sm text-gray-700">@label</span>
                                        </label>
                                    }
                                </div>
                            </div>
                        }
                        else if (_editingTable is null && _isLoadingDiscoveredTables)
                        {
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Tables</label>
                                <div class="flex items-center gap-2 text-sm text-gray-500 py-2.5">
                                    <div class="w-4 h-4 border-2 border-gray-300 border-t-dusk-blue-500 rounded-full animate-spin"></div>
                                    Loading tables from database...
                                </div>
                            </div>
                        }
                        else if (_editingTable is not null)
                        {
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                                    <input type="text" @bind="_tableName" placeholder="Table name"
                                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Schema</label>
                                    <input type="text" @bind="_tableSchema" placeholder="Optional schema (e.g. dbo)"
                                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors" />
                                </div>
                            </div>
                        }
                    }
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Sync Mode</label>
                        <select @bind="_tableSyncMode"
                                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors bg-white">
                            <option value="0">Upload and Download</option>
                            <option value="1">Upload Only</option>
                            <option value="2">Download Only</option>
                            <option value="3">Not Tracked</option>
                        </select>
                    </div>

                    @* Snapshot & Incremental section *@
                    <div class="border-t border-gray-200 pt-4 mt-4">
                        <h3 class="text-sm font-semibold text-gray-900 mb-3">Snapshot &amp; Incremental</h3>
                        <div class="space-y-4">
                            <label class="flex items-center gap-2 cursor-pointer">
                                <input type="checkbox" @bind="_tableSkipInitialSnapshot"
                                       class="size-4 rounded border-gray-300 text-dusk-blue-500 focus:ring-dusk-blue-500" />
                                <span class="text-sm text-gray-700">Skip initial snapshot</span>
                            </label>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Select Incremental Query</label>
                                <textarea @bind="_tableSelectIncrementalQuery" rows="3" placeholder="Optional custom SQL for incremental sync"
                                          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors font-mono text-sm resize-none"></textarea>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">Custom Snapshot Query</label>
                                <textarea @bind="_tableCustomSnapshotQuery" rows="3" placeholder="Optional custom SQL for initial snapshot"
                                          class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors font-mono text-sm resize-none"></textarea>
                            </div>
                        </div>
                    </div>

                    @* SQL Server options *@
                    @if (IsSqlServer)
                    {
                        <div class="border-t border-gray-200 pt-4 mt-4">
                            <h3 class="text-sm font-semibold text-gray-900 mb-3">SQL Server Options</h3>
                            <div class="space-y-4">
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Skip Columns</label>
                                    <input type="text" @bind="_tableSkipColumns" placeholder="e.g. CreatedDate, ModifiedBy"
                                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors" />
                                    <p class="text-xs text-gray-400 mt-1">Comma-separated column names to exclude from sync</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Skip Columns on Insert/Update</label>
                                    <input type="text" @bind="_tableSkipColumnsOnInsertOrUpdate" placeholder="e.g. ComputedCol, Timestamp"
                                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors" />
                                    <p class="text-xs text-gray-400 mt-1">Comma-separated column names to exclude only on insert/update</p>
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">Identity Insert</label>
                                    <select @bind="_tableIdentityInsert"
                                            class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors bg-white">
                                        <option value="0">Auto</option>
                                        <option value="1">On</option>
                                        <option value="2">Off</option>
                                        <option value="3">Disabled</option>
                                    </select>
                                </div>
                                <label class="flex items-center gap-2 cursor-pointer">
                                    <input type="checkbox" @bind="_tableForceReloadInsertedRecords"
                                           class="size-4 rounded border-gray-300 text-dusk-blue-500 focus:ring-dusk-blue-500" />
                                    <span class="text-sm text-gray-700">Force reload inserted records</span>
                                </label>
                            </div>
                        </div>
                    }
                </div>

                @if (_dialogErrorMessages.Count > 0)
                {
                    <div class="mt-4 p-3 bg-ink-black-900 border border-ink-black-700 rounded-lg">
                        @foreach (var error in _dialogErrorMessages)
                        {
                            <p class="text-sm text-ink-black-500">@error</p>
                        }
                    </div>
                }

                <div class="flex justify-end gap-3 mt-6">
                    <button @onclick="CloseTableDialog"
                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
                        Cancel
                    </button>
                    <button @onclick="SaveTable" disabled="@(IsDialogSaveDisabled || _isDialogSaving)"
                            class="px-4 py-2 text-sm font-medium text-white bg-dusk-blue-500 hover:bg-dusk-blue-600 rounded-lg transition-colors disabled:opacity-50">
                        @if (_isDialogSaving)
                        {
                            @("Saving...")
                        }
                        else if (_isBulkEdit)
                        {
                            @($"Apply to {_bulkEditTables.Count} Tables")
                        }
                        else if (_editingTable is null)
                        {
                            @($"Add {(_selectedNewTables.Count > 0 ? _selectedNewTables.Count : "")} Table{(_selectedNewTables.Count != 1 ? "s" : "")}")
                        }
                        else
                        {
                            @("Save")
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

