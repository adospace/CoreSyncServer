@page "/agents/{AgentId:int}/edit"
@attribute [Authorize]
@inherits InteractivePage
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@layout DashboardLayout
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization

<PageTitle>Edit Agent</PageTitle>

@if (_agent is null)
{
    <div class="flex items-center justify-center py-12">
        <div class="flex items-center gap-3 text-gray-500">
            <div class="w-5 h-5 border-2 border-gray-300 border-t-dusk-blue-500 rounded-full animate-spin"></div>
            <span class="text-sm">Loading agent...</span>
        </div>
    </div>
}
else
{
    <div class="space-y-6">
        <div>
            <button @onclick='() => NavigationManager.NavigateTo("/agents")' class="text-sm text-dusk-blue-500 hover:text-dusk-blue-600 hover:underline flex items-center gap-1 mb-2">
                <span class="i-lucide-arrow-left size-3.5"></span>
                Back to Agents
            </button>
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-bold text-gray-900">@_agent.Name</h1>
                        <AgentStatusIndicator IsConnected="_agent.IsConnected" LastSeen="_agent.LastSeen" ShowLabel="true" />
                    </div>
                    <p class="text-gray-500 mt-1 text-sm">Created @_agent.CreatedDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                </div>
                <button @onclick="SaveDetails" disabled="@(!HasUnsavedChanges || _isSaving || string.IsNullOrWhiteSpace(_editName))"
                        class="bg-dusk-blue-500 hover:bg-dusk-blue-600 text-white font-medium py-2 px-4 rounded-lg transition-colors text-sm flex items-center gap-2 disabled:opacity-50">
                    <span class="i-lucide-save size-4"></span>
                    @(_isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Agent Details</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Name</label>
                    <input type="text" @bind="_editName" placeholder="Enter agent name"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <input type="text" @bind="_editDescription" placeholder="Optional description"
                           class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors" />
                </div>
                <div class="md:col-span-2 flex items-center gap-3">
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" @bind="_editEnabled" class="sr-only peer" />
                        <div class="w-9 h-5 bg-gray-300 peer-focus:ring-2 peer-focus:ring-dusk-blue-500 rounded-full peer peer-checked:bg-dusk-blue-500 transition-colors after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:after:translate-x-full"></div>
                    </label>
                    <span class="text-sm font-medium text-gray-700">Enabled</span>
                </div>
            </div>

            @if (_detailErrorMessages.Count > 0)
            {
                <div class="mt-4 p-3 bg-ink-black-900 border border-ink-black-700 rounded-lg">
                    @foreach (var error in _detailErrorMessages)
                    {
                        <p class="text-sm text-ink-black-500">@error</p>
                    }
                </div>
            }
            @if (_detailSuccess is not null)
            {
                <div class="mt-4 p-3 bg-green-50 border border-green-200 rounded-lg flex items-center gap-2">
                    <span class="i-lucide-check-circle size-4 text-green-600"></span>
                    <p class="text-sm text-green-700">@_detailSuccess</p>
                </div>
            }
        </div>

        <div class="bg-white border border-gray-200 rounded-lg p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-gray-900">API Key</h2>
                <button @onclick="OpenRegenerateDialog"
                        class="text-sm font-medium text-red-600 hover:text-red-700 flex items-center gap-1">
                    <span class="i-lucide-refresh-cw size-4"></span>
                    Regenerate key
                </button>
            </div>
            <p class="text-sm text-gray-600 mb-3">
                The agent process uses this key to authenticate with the server. Use <strong>X-Agent-ApiKey</strong> header when calling the agent API.
            </p>
            <div class="flex items-center gap-2">
                @if (_showApiKey)
                {
                    <input type="text" readonly value="@_agent.ApiKey"
                           class="flex-1 px-4 py-2.5 border border-gray-300 rounded-lg font-mono text-sm bg-gray-50" />
                    <button @onclick="() => _showApiKey = false"
                            class="inline-flex items-center gap-1 px-2.5 py-2 text-xs font-medium text-dusk-blue-700 bg-dusk-blue-50 border border-dusk-blue-200 rounded-md hover:bg-dusk-blue-100 transition-colors">
                        <span class="i-lucide-eye-off size-3"></span>
                        HIDE
                    </button>
                }
                else
                {
                    <button @onclick="() => _showApiKey = true"
                            class="inline-flex items-center gap-1 px-2.5 py-2 text-xs font-medium text-dusk-blue-700 bg-dusk-blue-50 border border-dusk-blue-200 rounded-md hover:bg-dusk-blue-100 transition-colors">
                        <span class="i-lucide-eye size-3"></span>
                        SHOW
                    </button>
                }
                <button @onclick="CopyApiKey"
                        class="p-2 rounded-lg text-gray-500 hover:text-dusk-blue-500 hover:bg-gray-100 transition-colors"
                        title="Copy to clipboard">
                    <span class="@(_apiKeyCopied ? "i-lucide-check size-4 text-green-500" : "i-lucide-copy size-4")"></span>
                </button>
            </div>
        </div>

        <div class="bg-white border border-gray-200 rounded-lg p-6">
            <h2 class="text-lg font-semibold text-gray-900 mb-4">Linked Data Stores</h2>
            @if (_linkedDataStores is null)
            {
                <p class="text-sm text-gray-500">Loading...</p>
            }
            else if (_linkedDataStores.Count == 0)
            {
                <p class="text-sm text-gray-500">No data stores assigned to this agent.</p>
            }
            else
            {
                <ul class="divide-y divide-gray-100">
                    @foreach (var ds in _linkedDataStores)
                    {
                        <li class="flex items-center justify-between py-2">
                            <a href="@($"/data-stores/{ds.Id}/edit")" class="text-sm text-dusk-blue-600 hover:text-dusk-blue-700 hover:underline">@ds.Name</a>
                            <span class="text-xs text-gray-400">@ds.Type</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@if (_showRegenerateDialog)
{
    <div class="fixed inset-0 z-40 bg-black/50" @onclick="() => _showRegenerateDialog = false"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded border border-gray-200 w-full max-w-md" @onclick:stopPropagation="true">
            <div class="p-6">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-red-100 flex items-center justify-center">
                        <span class="i-lucide-alert-triangle size-5 text-red-600"></span>
                    </div>
                    <h2 class="text-lg font-semibold text-gray-900">Regenerate API Key</h2>
                </div>
                <p class="text-sm text-gray-600 mb-4">
                    This will invalidate the existing key. Any running agent process using the old key will disconnect and fail to re-authenticate.
                </p>
                <div class="flex justify-end gap-3">
                    <button @onclick="() => _showRegenerateDialog = false"
                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
                        Cancel
                    </button>
                    <button @onclick="RegenerateKey" disabled="@_isSaving"
                            class="px-4 py-2 text-sm font-medium text-white bg-red-600 hover:bg-red-700 rounded-lg transition-colors disabled:opacity-50">
                        @(_isSaving ? "Regenerating..." : "Regenerate")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int AgentId { get; set; }

    private AgentDetailDto? _agent;
    private string _editName = "";
    private string _editDescription = "";
    private bool _editEnabled;
    private string _savedName = "";
    private string _savedDescription = "";
    private bool _savedEnabled;
    private bool _showApiKey;
    private bool _apiKeyCopied;
    private bool _isSaving;
    private List<string> _detailErrorMessages = [];
    private string? _detailSuccess;
    private bool _showRegenerateDialog;
    private List<LinkedDataStoreDto>? _linkedDataStores;
    private IJSObjectReference? _clipboardModule;

    private bool HasUnsavedChanges =>
        _editName != _savedName
        || _editDescription != _savedDescription
        || _editEnabled != _savedEnabled;

    private record AgentDetailDto(int Id, string Name, string? Description, bool Enabled, DateTime CreatedDate, DateTime? LastSeen, bool IsConnected, string ApiKey);
    private record LinkedDataStoreDto(int Id, string Name, string Type);
    private record DataStoreDto(int Id, string Name, string? Description, string Type, string ProjectName, int ProjectId, int ConfigurationsCount, int SyncSessionsCount);

    protected override async Task OnInitializedInteractiveAsync()
    {
        await LoadAgent();
        await LoadLinkedDataStores();
    }

    private async Task LoadAgent()
    {
        _agent = await Http.GetFromJsonAsync<AgentDetailDto>($"api/agents/{AgentId}");
        if (_agent is not null)
        {
            _editName = _savedName = _agent.Name;
            _editDescription = _savedDescription = _agent.Description ?? "";
            _editEnabled = _savedEnabled = _agent.Enabled;
        }
    }

    private async Task LoadLinkedDataStores()
    {
        var all = await Http.GetFromJsonAsync<List<DataStoreDto>>("api/datastores");
        var agentStores = await Http.GetFromJsonAsync<List<DataStoreLinkedDto>>($"api/agents/{AgentId}/datastores");
        if (agentStores is not null)
        {
            _linkedDataStores = agentStores.Select(d => new LinkedDataStoreDto(d.Id, d.Name, d.Type)).ToList();
        }
        else if (all is not null)
        {
            _linkedDataStores = [];
        }
    }

    private record DataStoreLinkedDto(int Id, string Name, string Type);

    private async Task SaveDetails()
    {
        _isSaving = true;
        _detailErrorMessages = [];
        _detailSuccess = null;

        try
        {
            var request = new { Name = _editName.Trim(), Description = string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription.Trim(), Enabled = _editEnabled };
            var response = await Http.PutAsJsonAsync($"api/agents/{AgentId}", request);
            if (response.IsSuccessStatusCode)
            {
                _detailSuccess = "Agent updated successfully.";
                await LoadAgent();
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                _detailErrorMessages = errors ?? ["An unexpected error occurred."];
            }
        }
        catch (Exception ex)
        {
            _detailErrorMessages = [ex.Message];
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void OpenRegenerateDialog() => _showRegenerateDialog = true;

    private async Task RegenerateKey()
    {
        _isSaving = true;
        try
        {
            var response = await Http.PostAsync($"api/agents/{AgentId}/regenerate-key", null);
            if (response.IsSuccessStatusCode)
            {
                _showRegenerateDialog = false;
                _showApiKey = true;
                await LoadAgent();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CopyApiKey()
    {
        if (_agent is null) return;
        _clipboardModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/clipboard.js");
        await _clipboardModule.InvokeVoidAsync("copyText", _agent.ApiKey);
        _apiKeyCopied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _apiKeyCopied = false;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_clipboardModule is not null)
            await _clipboardModule.DisposeAsync();
    }
}
