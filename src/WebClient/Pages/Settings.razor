@page "/settings"
@attribute [Authorize]
@inherits InteractivePage
@inject NavigationManager Navigation
@layout DashboardLayout
@rendermode InteractiveWebAssembly
@using Microsoft.AspNetCore.Authorization

<PageTitle>Settings</PageTitle>

<div class="space-y-4">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Settings</h1>
        <p class="text-gray-500 mt-1">Manage your application preferences.</p>
    </div>

    @* Profile section *@
    <div class="bg-white rounded border border-gray-100 p-4">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Profile</h2>
        <div class="space-y-4 max-w-lg">
            @if (_profileErrorMessages.Count > 0)
            {
                <div class="p-3 bg-ink-black-900 border border-ink-black-700 rounded-lg">
                    @foreach (var error in _profileErrorMessages)
                    {
                        <p class="text-sm text-ink-black-500">@error</p>
                    }
                </div>
            }

            @if (_profileSuccessMessage is not null)
            {
                <div class="p-3 bg-green-50 border border-green-200 rounded-lg flex items-center gap-2">
                    <span class="i-lucide-check-circle size-4 text-green-600"></span>
                    <p class="text-sm text-green-700">@_profileSuccessMessage</p>
                </div>
            }

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
                <input type="text" @bind="_formUserName" placeholder="Your username"
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors" />
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                <input type="email" @bind="_formEmail" placeholder="you@example.com"
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-dusk-blue-500 focus:border-dusk-blue-500 outline-none transition-colors" />
            </div>
            <button @onclick="SaveProfile" disabled="@_isSavingProfile"
                    class="bg-dusk-blue-500 hover:bg-dusk-blue-600 text-white font-medium py-2 px-4 rounded-lg transition-colors text-sm disabled:opacity-50">
                @(_isSavingProfile ? "Saving..." : "Save Changes")
            </button>
        </div>
    </div>

    @* Notifications section — coming soon *@
    @*
    <div class="bg-white rounded border border-gray-100 p-4">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Notifications</h2>
        <div class="space-y-3">
            <label class="flex items-center justify-between cursor-pointer">
                <span class="text-sm text-gray-700">Email notifications</span>
                <div class="w-10 h-6 bg-dusk-blue-500 rounded-full relative">
                    <div class="w-4 h-4 bg-white rounded-full absolute top-1 right-1 shadow-sm"></div>
                </div>
            </label>
            <label class="flex items-center justify-between cursor-pointer">
                <span class="text-sm text-gray-700">Push notifications</span>
                <div class="w-10 h-6 bg-gray-300 rounded-full relative">
                    <div class="w-4 h-4 bg-white rounded-full absolute top-1 left-1 shadow-sm"></div>
                </div>
            </label>
            <label class="flex items-center justify-between cursor-pointer">
                <span class="text-sm text-gray-700">Sync alerts</span>
                <div class="w-10 h-6 bg-dusk-blue-500 rounded-full relative">
                    <div class="w-4 h-4 bg-white rounded-full absolute top-1 right-1 shadow-sm"></div>
                </div>
            </label>
        </div>
    </div>
    *@

    @* Danger zone *@
    <div class="bg-white rounded border border-ink-black-700 p-4">
        <h2 class="text-lg font-semibold text-ink-black-500 mb-2">Danger Zone</h2>
        <p class="text-sm text-gray-500 mb-4">Irreversible and destructive actions.</p>
        <button @onclick="OpenDeleteDialog"
                class="bg-ink-black-500 hover:bg-ink-black-400 text-white font-medium py-2 px-4 rounded-lg transition-colors text-sm">
            Delete Account
        </button>
    </div>
</div>

@* Delete account confirmation dialog *@
@if (_showDeleteDialog)
{
    <div class="fixed inset-0 z-40 bg-black/50" @onclick="CloseDeleteDialog"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded border border-gray-200 w-full max-w-md" @onclick:stopPropagation="true">
            <div class="p-6">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-10 h-10 rounded-lg bg-ink-black-900 flex items-center justify-center">
                        <span class="i-lucide-alert-triangle size-5 text-ink-black-500"></span>
                    </div>
                    <h2 class="text-lg font-semibold text-gray-900">Delete Account</h2>
                </div>
                <p class="text-sm text-gray-600 mb-4">
                    This will permanently delete your account and all associated data. This action cannot be undone.
                </p>
                <p class="text-sm text-gray-600 mb-6">
                    Type <strong>delete my account</strong> to confirm.
                </p>

                <input type="text" @bind="_deleteConfirmText" placeholder="delete my account"
                       class="w-full px-4 py-2.5 border border-gray-300 rounded-lg focus:ring-2 focus:ring-ink-black-500 focus:border-ink-black-500 outline-none transition-colors mb-4" />

                @if (_deleteErrorMessages.Count > 0)
                {
                    <div class="mb-4 p-3 bg-ink-black-900 border border-ink-black-700 rounded-lg">
                        @foreach (var error in _deleteErrorMessages)
                        {
                            <p class="text-sm text-ink-black-500">@error</p>
                        }
                    </div>
                }

                <div class="flex justify-end gap-3">
                    <button @onclick="CloseDeleteDialog"
                            class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors">
                        Cancel
                    </button>
                    <button @onclick="DeleteAccount" disabled="@(_isDeleting || _deleteConfirmText != "delete my account")"
                            class="px-4 py-2 text-sm font-medium text-white bg-ink-black-500 hover:bg-ink-black-400 rounded-lg transition-colors disabled:opacity-50">
                        @(_isDeleting ? "Deleting..." : "Delete Account")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private record ProfileDto(string UserName, string? Email);

    // Profile
    private string _formUserName = "";
    private string _formEmail = "";
    private bool _isSavingProfile;
    private List<string> _profileErrorMessages = [];
    private string? _profileSuccessMessage;

    // Delete account
    private bool _showDeleteDialog;
    private string _deleteConfirmText = "";
    private bool _isDeleting;
    private List<string> _deleteErrorMessages = [];

    protected override async Task OnInitializedInteractiveAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        var profile = await Http.GetFromJsonAsync<ProfileDto>("api/account/profile");
        if (profile is not null)
        {
            _formUserName = profile.UserName;
            _formEmail = profile.Email ?? "";
        }
    }

    private async Task SaveProfile()
    {
        _isSavingProfile = true;
        _profileErrorMessages = [];
        _profileSuccessMessage = null;

        try
        {
            var response = await Http.PutAsJsonAsync("api/account/profile",
                new { UserName = _formUserName, Email = _formEmail });

            if (response.IsSuccessStatusCode)
            {
                _profileSuccessMessage = "Profile updated successfully.";
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                _profileErrorMessages = errors ?? ["An unexpected error occurred."];
            }
        }
        catch (Exception ex)
        {
            _profileErrorMessages = [ex.Message];
        }
        finally
        {
            _isSavingProfile = false;
        }
    }

    private void OpenDeleteDialog()
    {
        _deleteConfirmText = "";
        _deleteErrorMessages = [];
        _showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        _showDeleteDialog = false;
        _deleteConfirmText = "";
        _deleteErrorMessages = [];
    }

    private async Task DeleteAccount()
    {
        _isDeleting = true;
        _deleteErrorMessages = [];

        try
        {
            var response = await Http.DeleteAsync("api/account");

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("Account/PerformLogout", forceLoad: true);
            }
            else
            {
                var errors = await response.Content.ReadFromJsonAsync<List<string>>();
                _deleteErrorMessages = errors ?? ["An unexpected error occurred."];
            }
        }
        catch (Exception ex)
        {
            _deleteErrorMessages = [ex.Message];
        }
        finally
        {
            _isDeleting = false;
        }
    }
}
